From: SSBS preserve (Wine MR 12262, "ntdll: Ignore attempts to set reserved CPSR bits")
Subject: [PATCH] ntdll/arm64: keep the host SSBS bit across signal returns

Wine rebuilt PSTATE from the Windows CONTEXT on every signal return (exception fixups,
NtSetContextThread on another thread, the SIGUSR2 suspend path). CONTEXT.Cpsr never carries
SSBS (bit 12), so threads resumed with SSBS clear, i.e. with speculative store bypass
disabled, which is the slow mode.

 * unix_private.h: cpsr_user_mask (0xf620fc30) - the CPSR bits a Windows CONTEXT may carry.
 * Every CONTEXT -> PSTATE path masks Cpsr with cpsr_user_mask (save_context, the syscall
   frame, the wow64 frame, NtSetContextThread's server context).
 * restore_context and usr2_handler keep the host's bits (everything outside the user mask,
   plus SSBS) instead of overwriting them: SSBS stays as the kernel set it, it is not forced.
 * WINE_FORCE_SSBS=0 drops the SSBS part from the preserved bits (stock behaviour).

Based on the work of Jacek Caban (MR 12262, Wine-Bug 60405); problem found by Sonicadvance1.
Applies on top of common/dlls_ntdll_unix_unix_private_h.patch and
test-bylaws/dlls_ntdll_unix_signal_arm64_c.patch.
---
diff --git a/dlls/ntdll/unix/signal_arm64.c b/dlls/ntdll/unix/signal_arm64.c
index c18e650..f2da38e 100644
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -299,6 +299,12 @@ static void restore_fpu( const CONTEXT *context, ucontext_t *sigcontext )
 }
 
 
+/* Preserve all CPSR bits not covered by user context in signal handlers.
+ * Additionally, preserve the host SSBS bit, which is allowed to be set on
+ * Windows, but is volatile and restored on kernel transition anyway.
+ * (Wine MR 12262.) WINE_FORCE_SSBS=0 drops the SSBS part for stock behaviour. */
+static ULONG cpsr_host_mask = ~cpsr_user_mask | 0x1000;
+
 /***********************************************************************
  *           save_context
  *
@@ -313,7 +319,7 @@ static void save_context( CONTEXT *context, const ucontext_t *sigcontext )
     context->Lr   = LR_sig(sigcontext);     /* Link register */
     context->Sp   = SP_sig(sigcontext);     /* Stack pointer */
     context->Pc   = PC_sig(sigcontext);     /* Program Counter */
-    context->Cpsr = PSTATE_sig(sigcontext); /* Current State Register */
+    context->Cpsr = PSTATE_sig(sigcontext) & cpsr_user_mask; /* Current State Register */
     for (i = 0; i <= 28; i++) context->X[i] = REGn_sig( i, sigcontext );
     save_fpu( context, sigcontext );
 }
@@ -332,7 +338,7 @@ static void restore_context( const CONTEXT *context, ucontext_t *sigcontext )
     LR_sig(sigcontext)     = context->Lr;   /* Link register */
     SP_sig(sigcontext)     = context->Sp;   /* Stack pointer */
     PC_sig(sigcontext)     = context->Pc;   /* Program Counter */
-    PSTATE_sig(sigcontext) = context->Cpsr; /* Current State Register */
+    PSTATE_sig(sigcontext) = (PSTATE_sig(sigcontext) & cpsr_host_mask) | (context->Cpsr & cpsr_user_mask); /* Current State Register */
     for (i = 0; i <= 28; i++) REGn_sig( i, sigcontext ) = context->X[i];
     restore_fpu( context, sigcontext );
 }
@@ -425,7 +431,7 @@ NTSTATUS WINAPI NtSetContextThread( HANDLE handle, const CONTEXT *context )
         frame->lr    = context->Lr;
         frame->sp    = context->Sp;
         frame->pc    = context->Pc;
-        frame->cpsr  = context->Cpsr;
+        frame->cpsr  = context->Cpsr & cpsr_user_mask;
     }
     if (flags & CONTEXT_FLOATING_POINT)
     {
@@ -594,7 +600,7 @@ NTSTATUS set_thread_wow64_context( HANDLE handle, const void *ctx, ULONG size )
             wow_frame->Sp = context->Sp;
             wow_frame->Lr = context->Lr;
             wow_frame->Pc = context->Pc & ~1;
-            wow_frame->Cpsr = context->Cpsr;
+            wow_frame->Cpsr = context->Cpsr & cpsr_user_mask;
             if (context->Cpsr & 0x20) wow_frame->Pc |= 1; /* thumb */
         }
         if (flags & CONTEXT_FLOATING_POINT)
@@ -1385,7 +1391,7 @@ static void usr2_handler( int signal, siginfo_t *siginfo, void *sigcontext )
     LR_sig(context)     = frame->lr;
     SP_sig(context)     = frame->sp;
     PC_sig(context)     = frame->pc;
-    PSTATE_sig(context) = frame->cpsr;
+    PSTATE_sig(context) = (PSTATE_sig(context) & cpsr_host_mask) | frame->cpsr;
     for (i = 0; i <= 28; i++) REGn_sig( i, context ) = frame->x[i];
 
 #ifdef linux
@@ -1459,6 +1465,10 @@ void signal_init_process(void)
     void *kernel_stack = (char *)thread_data->kernel_stack + kernel_stack_size;
 
     thread_data->syscall_frame = (struct syscall_frame *)kernel_stack - 1;
+    {
+        const char *env = getenv( "WINE_FORCE_SSBS" );
+        if (env && env[0] == '0') cpsr_host_mask &= ~0x1000;
+    }
 
     signal_alloc_thread( NtCurrentTeb() );
 
diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
index 9ee9239..3228601 100644
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -544,7 +544,7 @@ static NTSTATUS context_to_server( struct context_data *to, USHORT to_machine, c
             to->ctl.arm_regs.sp   = from->Sp;
             to->ctl.arm_regs.lr   = from->Lr;
             to->ctl.arm_regs.pc   = from->Pc;
-            to->ctl.arm_regs.cpsr = from->Cpsr;
+            to->ctl.arm_regs.cpsr = from->Cpsr & cpsr_user_mask;
         }
         if (flags & CONTEXT_ARM_INTEGER)
         {
@@ -593,7 +593,7 @@ static NTSTATUS context_to_server( struct context_data *to, USHORT to_machine, c
             to->integer.arm64_regs.x[30] = from->Lr;
             to->ctl.arm64_regs.sp     = from->Sp;
             to->ctl.arm64_regs.pc     = from->Pc;
-            to->ctl.arm64_regs.pstate = from->Cpsr;
+            to->ctl.arm64_regs.pstate = from->Cpsr & cpsr_user_mask;
         }
         if (flags & CONTEXT_ARM64_INTEGER)
         {
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
index 2f649ca..a9075b7 100644
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -627,6 +627,8 @@ static inline NTSTATUS map_section( HANDLE mapping, void **ptr, SIZE_T *size, UL
                                0, NULL, size, ViewShare, 0, protect );
 }
 
+static const ULONG cpsr_user_mask = 0xf620fc30;
+
 /* LDT definitions */
 
 #if defined(__i386__) || defined(__x86_64__)
