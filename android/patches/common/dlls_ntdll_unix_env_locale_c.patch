diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -723,6 +723,19 @@ static const NLS_LOCALE_DATA *get_win_locale( const NLS_LOCALE_HEADER *header, c
 }
 
 
+#ifdef __ANDROID__
+/* Resolve a locale category from the environment the way glibc would
+ * (LC_ALL, then the category itself, then LANG); falls back to "C.UTF-8". */
+static const char *android_getenv_locale( const char *category )
+{
+    const char *v = getenv( "LC_ALL" );
+    if (v && v[0]) return v;
+    if (category && (v = getenv( category )) && v[0]) return v;
+    if ((v = getenv( "LANG" )) && v[0]) return v;
+    return "C.UTF-8";
+}
+#endif
+
 /******************************************************************
  *		init_locale
  */
@@ -734,12 +747,26 @@ static void init_locale(void)
     const NLS_LOCALE_DATA *locale;
     char *p;
 
+#ifdef __ANDROID__
+    /* bionic's setlocale() never looks at the environment: setlocale( cat, "" ) always
+     * succeeds and reports "C.UTF-8", which unix_to_win_locale() can't map to a Windows
+     * locale (and which skips its LC_ALL fallback, that only triggers for "C").
+     * So read the POSIX variables ourselves, with the usual precedence
+     * LC_ALL > LC_CTYPE / LC_MESSAGES > LANG, as Winlator exports LC_ALL. */
+    setlocale( LC_ALL, "" );
+    all = android_getenv_locale( NULL );
+    ctype = android_getenv_locale( "LC_CTYPE" );
+    messages = android_getenv_locale( "LC_MESSAGES" );
+    TRACE_(nls)( "Android: LC_ALL %s LC_CTYPE %s LC_MESSAGES %s\n",
+                 debugstr_a(all), debugstr_a(ctype), debugstr_a(messages) );
+#else
     if (!(all = setlocale( LC_ALL, "" )) && (all = getenv( "LC_ALL" )))
         FIXME_(nls)( "Failed to set LC_ALL to %s, is the locale supported?\n", debugstr_a(all) );
     if (!(ctype = setlocale( LC_CTYPE, "" )) && (ctype = getenv( "LC_CTYPE" )))
         FIXME_(nls)( "Failed to set LC_CTYPE to %s, is the locale supported?\n", debugstr_a(ctype) );
     if (!(messages = setlocale( LC_MESSAGES, "" )) && (messages = getenv( "LC_MESSAGES" )))
         FIXME_(nls)( "Failed to set LC_MESSAGES to %s, is the locale supported?\n", debugstr_a(messages) );
+#endif
 
     if (!unix_to_win_locale( ctype, system_locale )) system_locale[0] = 0;
     TRACE_(nls)( "Unix LC_CTYPE is %s, setting system locale to %s\n", debugstr_a(ctype), debugstr_a(user_locale) );
